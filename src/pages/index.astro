---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'TIME Internet Promo & Referral Sign Up Malaysia';
const description =
  'Sign up for TIME Internet Malaysia referral assistance. New customers may receive an RM50 referral bill discount after successful activation, subject to TIME terms.';
---

<BaseLayout title={title} description={description}>
  <section class="signup" id="apply">
    <div class="signup-copy">
      <p class="eyebrow">TIME Internet Malaysia referral assistance</p>
      <h1>Sign up for TIME Internet promo help</h1>
      <p class="lead">
        Fill in the form and we will help check your condo coverage and guide your TIME Fibre Home sign-up.
      </p>

      <ul class="promo-list" aria-label="Current TIME Internet promotion summary">
        <li>New sign-ups using a valid TIME referral may receive an RM50 one-time bill discount after successful activation.</li>
        <li>TIME currently lists 600Mbps at RM99/month for the first 6 full months on a 24-month contract, valid until 1 June 2026.</li>
        <li>Official TIME terms, coverage, installation availability, and plan pricing still apply.</li>
      </ul>

      <p class="disclaimer">
        Independent referral assistance page. This is not the official TIME website.
      </p>

      <p class="source-note">
        Sources:
        <a href="https://www.time.com.my/terms-and-conditions/promotions/" rel="nofollow">TIME promotions terms</a>
        and
        <a href="https://www.time.com.my/support/for-home/faq?faq=home" rel="nofollow">TIME Home FAQ</a>.
      </p>
    </div>

    <div class="form-shell">
      <h2>Submit your details</h2>
      <p>Use the form below to request referral assistance.</p>
      <iframe
        aria-label="TIME Internet Promo & Referral Sign up Form"
        frameborder="0"
        style="height:500px;width:99%;border:none;"
        src="https://forms.zohopublic.com/supportgamere1/form/TimeInternetPromoSignupForm/formperma/cDIMWNLjVjq9FVSwJjXm7PHGM0clvWVlTJ9sF4ksBfw"
      >
      </iframe>
    </div>
  </section>
</BaseLayout>
