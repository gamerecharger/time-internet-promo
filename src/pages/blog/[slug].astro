---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} | TIME Internet Malaysia Guide`;
const canonical = new URL(`/blog/${post.slug}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  inLanguage: 'en-MY',
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: 'TIME Internet Promo & Referral Assistance Malaysia',
    url: new URL('/', Astro.site).href,
  },
  publisher: {
    '@type': 'Organization',
    name: 'TIME Internet Promo & Referral Assistance Malaysia',
    url: new URL('/', Astro.site).href,
  },
};
---

<BaseLayout title={title} description={post.data.description} canonical={canonical} structuredData={structuredData}>
  <article class="article">
    <p class="article-meta">
      {post.data.pubDate.toLocaleDateString('en-MY', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>
    <h1>{post.data.title}</h1>
    <p class="article-meta">{post.data.description}</p>
    <Content />
    <div class="article-cta">
      <h2>Ready to check your TIME promo?</h2>
      <p>Use the referral assistance form to check condo coverage and request sign-up help.</p>
      <a class="button" href="/#apply">Go to sign-up form</a>
    </div>
  </article>
</BaseLayout>
