---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'TIME Internet Malaysia Blog | Promo, Coverage & Condo Guides';
const description =
  'SEO guides about TIME Internet Malaysia promos, condo coverage checks, and broadband comparisons for apartment users.';
---

<BaseLayout title={title} description={description}>
  <section class="section alt">
    <div class="wrap">
      <h1>TIME Internet Malaysia Blog</h1>
      <p>
        Practical guides for comparing TIME Internet promos, checking condo coverage, and preparing your referral assistance request.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap article-list">
      {
        posts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.slug}/`}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <p class="article-meta">
                {post.data.pubDate.toLocaleDateString('en-MY', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
