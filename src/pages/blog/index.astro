---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'TIME Internet Malaysia Blog | Promo, Coverage & Condo Guides';
const description =
  'SEO guides about TIME Internet Malaysia promos, condo coverage checks, and broadband comparisons for apartment users.';
const canonical = new URL('/blog/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en-MY',
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    datePublished: post.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <section class="section alt">
    <div class="wrap">
      <h1>TIME Internet Malaysia Blog</h1>
      <p>
        Practical guides for comparing TIME Internet promos, checking condo coverage, and preparing your referral assistance request.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap article-list">
      {
        posts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.slug}/`}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <p class="article-meta">
                {post.data.pubDate.toLocaleDateString('en-MY', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
