---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Notice | TIME Internet Referral Assistance';
const description =
  'Privacy notice for TIME Internet referral assistance, coverage checking, application follow-up, and related communication.';
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <h1>Privacy Notice</h1>
    <p>
      This Privacy Notice explains how personal data submitted through this website or the embedded form may be collected, used, and disclosed for TIME Internet referral assistance.
    </p>

    <h2>Personal Data We Collect</h2>
    <p>
      We may collect your name, phone number, email address, and information needed to assist with TIME Internet coverage checking, referral submission, and application follow-up.
    </p>

    <h2>Purpose Of Use</h2>
    <p>
      Your personal data is used only for TIME Internet coverage checking, referral submission, application follow-up, and related communication by phone or email.
    </p>

    <h2>Disclosure</h2>
    <p>
      Your details may be submitted through the TIME app or shared with the relevant TIME Internet representative, authorised referral channel, or service provider for the above purposes.
    </p>

    <h2>Independent Referral Assistance</h2>
    <p>
      This website provides independent referral assistance and is not the official TIME website. Your details will not be sold or used for unrelated marketing.
    </p>

    <h2>Security And Retention</h2>
    <p>
      We take reasonable steps to protect submitted information and keep it only for as long as needed for referral or application assistance, unless a longer period is required by law or operational record keeping.
    </p>

    <h2>Access Or Correction</h2>
    <p>
      You may request access to or correction of your submitted personal data by contacting the form owner through the contact details used for this referral assistance service.
    </p>

    <p>
      Do not submit credit card details, banking PINs, OTPs, account passwords, or other confidential credentials through this website or form.
    </p>
  </article>
</BaseLayout>
