---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  hideHeader?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  hideHeader = false,
  structuredData,
} = Astro.props;

const siteName = 'TIME Internet Promo & Referral Assistance Malaysia';
const schemaItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      schemaItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    {
      !hideHeader && (
        <header class="site-header">
          <a class="brand" href="/" aria-label="Homepage">TIME Referral Help</a>
          <nav aria-label="Primary navigation">
            <a href="/#apply">Sign Up</a>
            <a href="/blog/">Guides</a>
          </nav>
        </header>
      )
    }
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #151a1f;
    --muted: #59636c;
    --line: #dfe5e8;
    --paper: #ffffff;
    --soft: #f7f9f9;
    --accent: #0b7a75;
    --accent-dark: #075c58;
    --warm: #e8b03e;
    --max: 1040px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--soft);
    color: var(--ink);
    line-height: 1.6;
  }

  a {
    color: var(--accent-dark);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(100% - 32px, var(--max));
    margin: 0 auto;
    padding: 16px 0;
  }

  .brand {
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 18px;
    font-size: 0.92rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent-dark);
  }

  .section {
    padding: 72px 0;
  }

  .section.alt {
    background: var(--soft);
  }

  .wrap {
    width: min(100% - 32px, var(--max));
    margin: 0 auto;
  }

  .signup {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(360px, 1.14fr);
    gap: 32px;
    width: min(100% - 32px, var(--max));
    margin: 0 auto;
    padding: 42px 0 56px;
    align-items: start;
  }

  .signup.form-only {
    display: block;
    width: min(100% - 24px, 720px);
    padding: 16px 0 28px;
  }

  .signup-copy {
    padding-top: 12px;
  }

  h1,
  h2,
  h3 {
    line-height: 1.18;
    letter-spacing: 0;
    margin: 0 0 16px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.65rem);
  }

  h2 {
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    margin: 0 0 18px;
  }

  .lead {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 620px;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .promo-list {
    display: grid;
    gap: 10px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  .promo-list li {
    border-left: 4px solid var(--accent);
    background: var(--paper);
    padding: 12px 14px;
  }

  .discount {
    color: var(--accent-dark);
    display: inline-block;
    font-size: 1.55rem;
    font-weight: 900;
    line-height: 1;
    margin-right: 6px;
  }

  .disclaimer,
  .source-note {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .source-note a {
    color: var(--muted);
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 18px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: var(--warm);
    color: #1f252b;
    font-weight: 800;
    text-decoration: none;
  }

  .button.secondary {
    border-color: rgba(255, 255, 255, 0.52);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .card {
    min-height: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 24px;
  }

  .card h2 {
    font-size: 1.35rem;
  }

  .card p,
  .article-meta {
    color: var(--muted);
  }

  .notice {
    border-left: 5px solid var(--warm);
    background: #fff9eb;
    padding: 18px 20px;
  }

  .form-shell {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 18px 44px rgba(21, 26, 31, 0.08);
  }

  .form-shell h1 {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
  }

  .privacy-link {
    margin: 10px 0 0;
    text-align: center;
  }

  .seo-support {
    margin-top: 24px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .seo-support h2 {
    font-size: clamp(1.25rem, 3vw, 1.7rem);
  }

  .faq-list {
    display: grid;
    gap: 12px;
    margin-top: 16px;
  }

  .faq-list details {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 12px 14px;
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: 800;
  }

  .faq-list p {
    color: var(--muted);
    margin: 10px 0 0;
  }

  .placeholder {
    display: grid;
    place-items: center;
    min-height: 220px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    text-align: center;
  }

  .article-list {
    display: grid;
    gap: 18px;
  }

  .article-list a {
    color: var(--ink);
    text-decoration: none;
  }

  .article {
    width: min(100% - 32px, 760px);
    margin: 0 auto;
    padding: 64px 0 80px;
  }

  .article h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .article h2 {
    margin-top: 40px;
    font-size: clamp(1.45rem, 3vw, 2.1rem);
  }

  .article-cta {
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 24px;
  }

  .article-cta h2 {
    margin-top: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: center;
      flex-direction: row;
      gap: 12px;
    }

    nav {
      justify-content: flex-start;
    }

    .signup {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 28px 0 40px;
    }

    .signup-copy {
      padding-top: 0;
    }
  }
</style>
